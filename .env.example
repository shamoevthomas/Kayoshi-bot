# Copie ce fichier en ".env" et remplis les valeurs (voir README)

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID de ton serveur Discord de test (clic droit sur le serveur > Copier l'identifiant)
# Sert à enregistrer les commandes instantanément pendant le dev.
GUILD_ID=

# Stockage Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_KEY=
